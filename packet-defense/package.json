{
  "name": "packet-defense",
  "version": "1.0.5",
  "private": true,
  "description": "Packet Defense - a tower defence game about holding a production server against everything the internet throws at it.",
  "scripts": {
    "serve": "node tools/serve.js",
    "relay": "node server/relay/index.js",
    "verify": "node tools/verify.js",
    "verify:full": "node tools/verify.js --full",
    "backlog": "node tools/backlog.js --summary",
    "assets": "node tools/store-assets.js",
    "shots": "node tools/screenshots.js",
    "android:prepare": "npx cap sync android && node tools/harden-android.js",
    "android:add": "cap add android",
    "android:harden": "node tools/harden-android.js",
    "android:open": "cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "validator": "node server/validator/index.js",
    "validator:keys": "node server/validator/sign.js --generate",
    "validator:mock": "node tools/mock-validator.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
