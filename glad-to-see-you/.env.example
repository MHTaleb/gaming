# =====================================================================
# Glad to See You — environment template
# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# =====================================================================

# --- Meshy (3D asset generation) — official MCP server --------------
# Get a key at https://www.meshy.ai/settings/api (requires paid plan).
# Used by the Meshy MCP server. Do NOT make paid generation calls
# without explicit owner approval (each task costs credits).
MESHY_API_KEY=msy_REPLACE_ME

# --- Optional AI asset services (documented, not enabled) -----------
# TRIPO_API_KEY=
# SCENARIO_API_KEY=
# ROKOKO_API_KEY=
# DEEPMOTION_API_KEY=

# --- Unity MCP ------------------------------------------------------
# No key required. The Unity side is a package installed inside the
# editor; the MCP server is launched via uvx (see .vscode/mcp.json).
# Nothing to fill in here.

# --- Blender MCP ----------------------------------------------------
# No key required. Addon + `uvx mcp-for-blender` (see .vscode/mcp.json).
