# --- Neon Stack purchase validator -------------------------------------
# Copy to server/validator/.env and fill in. Never commit the filled version.

PORT=8787

# Must match appId in www/js/config.js, or every request is rejected.
APP_ID=com.yourstudio.neonstack
PACKAGE_NAME=com.yourstudio.neonstack

PRODUCTS=remove_ads,coins_small,coins_medium,coins_large
CONSUMABLE_PRODUCTS=coins_small,coins_medium,coins_large

# Google service account JSON: raw JSON, base64 of it, or a path to the file.
# Create it in Google Cloud, then invite the client_email in
# Play Console -> Users and permissions with "View financial data".
GOOGLE_SERVICE_ACCOUNT=

# Ed25519 private key, base64 PKCS8 DER.
# Generate both halves with: node server/validator/sign.js --generate
SIGNING_KEY=

# Requests per IP per minute.
RATE_LIMIT=30
