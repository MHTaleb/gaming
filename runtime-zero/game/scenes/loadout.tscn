[node name="Actions" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="BeginButton" type="Button" parent="Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
