[node name="BackButton" type="Button" parent="Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(200, 52)
text = "Back to title"

[node name="HintLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "The effect lasts the whole run. Every encounter starts at full HP and energy. Keys: Tab moves focus, Enter activates."
